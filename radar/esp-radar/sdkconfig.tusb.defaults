# TinyUSB CDC-ACM variant: idf.py -B build_tusb -D SDKCONFIG=sdkconfig.tusb -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.tusb.defaults" build
CONFIG_RADAR_USB_TINYUSB=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=8192
CONFIG_TINYUSB_CDC_TX_BUFSIZE=16384
CONFIG_TINYUSB_CDC_EP_BUFSIZE=8192
